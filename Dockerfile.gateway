# syntax=docker/dockerfile:1
FROM golang:1.27.3-bookworm AS builder
WORKDIR /src
COPY gateway/go.mod gateway/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY gateway ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gateway . \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/subscriber ./cmd/subscriber \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/order ./cmd/order

FROM debian:bookworm-slim AS runtime
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN groupadd --gid 10001 pulsefeed && useradd --uid 10001 --gid 10001 --no-create-home pulsefeed
COPY --from=builder /out/gateway /usr/local/bin/gateway
COPY --from=builder /out/subscriber /usr/local/bin/subscriber
COPY --from=builder /out/order /usr/local/bin/order
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=2s --start-period=5s --retries=5 \
    CMD ["/usr/local/bin/gateway", "--healthcheck"]
ENTRYPOINT ["/usr/local/bin/gateway"]
