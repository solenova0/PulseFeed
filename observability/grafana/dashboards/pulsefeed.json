{
  "id": null,
  "uid": "pulsefeed",
  "title": "PulseFeed \u2014 Market Data Pipeline",
  "tags": [
    "pulsefeed"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Engine throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsefeed-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(engine_commands_total[1m])",
          "legendFormat": "commands/s"
        },
        {
          "refId": "B",
          "expr": "rate(engine_trades_total[1m])",
          "legendFormat": "executions/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "Backpressure and sequence gaps",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsefeed-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(engine_feed_dropped_total[1m])",
          "legendFormat": "engine envelope drops/s"
        },
        {
          "refId": "B",
          "expr": "rate(engine_ingress_full_total[1m])",
          "legendFormat": "engine ingress rejects/s"
        },
        {
          "refId": "C",
          "expr": "rate(pulsefeed_gateway_sequence_gaps_total[1m])",
          "legendFormat": "gateway missing sequences/s"
        },
        {
          "refId": "D",
          "expr": "rate(pulsefeed_gateway_slow_clients_total[1m])",
          "legendFormat": "slow WebSocket clients/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "Engine timestamp to gateway fanout age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsefeed-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(pulsefeed_gateway_event_age_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pulsefeed_gateway_event_age_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pulsefeed_gateway_event_age_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
